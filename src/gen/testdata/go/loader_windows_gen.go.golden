// dlOpen loads the library into this process. purego has no Dlopen on
// Windows; it resolves symbols out of a HMODULE instead, which is what
// syscall.LoadLibrary returns.
//
// The path is made absolute first. LoadLibrary applies the full DLL search
// order to a relative name -- application directory, system directories,
// then %PATH% -- so a bare name out of the environment override could load
// a different file than the one that was named. An absolute path names one
// file and nothing else.
func dlOpen(path string) (uintptr, error) {
	abs, err := filepath.Abs(path)
	if err != nil {
		return 0, err
	}
	handle, err := syscall.LoadLibrary(abs)
	if err != nil {
		return 0, err
	}
	return uintptr(handle), nil
}

func dlClose(handle uintptr) error {
