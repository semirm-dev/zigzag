// Code generated by zbridge 0.1.0. DO NOT EDIT.
// Source: src/c_api.zig
// ABI: 0123456789abcdef

package zdemo

import (
	"crypto/sha256"
	"encoding/hex"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"runtime"
	"sync"

	"github.com/ebitengine/purego"
)

const (
	// libName is the library base name these bindings were generated from.
	libName = "zdemo"
	// libVersion is the zbridge version that generated them.
	libVersion = "0.1.0"
	// abiSymbol is the function the native library exports so the bindings can
	// prove they were generated from the same source.
	abiSymbol = "zdemo_zbridge_abi_hash"
	// abiHash is the ABI fingerprint of the exported surface, as text.
	abiHash = "0123456789abcdef"
	// abiHashValue is abiHash as the number the native library reports.
	abiHashValue uint64 = 0x0123456789abcdef
)

// LibPathEnv names an environment variable that, when set, points at a native
// library to load directly. Setting it skips extraction of the embedded copy
// entirely, which is what you want while developing the library itself. The
// ABI check still applies.
const LibPathEnv = "ZDEMO_LIB_PATH"

var (
	loadOnce  sync.Once
	loadErr   error
	libHandle uintptr
)

// Load opens the native library, verifies its ABI and resolves every exported
// symbol. It does that work at most once; later calls return the same result.
// Every generated function calls it, so calling it yourself is only useful to
// surface a load failure as an error at a point you choose.
func Load() error {
	loadOnce.Do(func() { loadErr = load() })
	return loadErr
}

// mustLoad is what the generated wrappers call. A failure here is a broken
// installation, not a runtime condition a caller can act on.
func mustLoad() {
	if err := Load(); err != nil {
		panic(err)
	}
}

func load() error {
	path, err := libraryPath()
	if err != nil {
		return err
	}
	handle, err := dlOpen(path)
	if err != nil {
		return fmt.Errorf("%s: opening %s: %w", libName, path, err)
	}
	// Past this point the library is mapped into the process, so every failure
	// closes it again rather than leaving a mapping behind. Both steps below
	// can fail through a purego panic, and each turns that into an error of its
	// own so neither can skip the close.
	if err := checkABI(handle); err != nil {
		_ = dlClose(handle)
		return err
	}
	if err := bindAll(handle); err != nil {
		_ = dlClose(handle)
		return err
	}
	libHandle = handle
	return nil
}

// checkABI refuses a native library that was built from a different exported
// surface than these bindings were generated from.
func checkABI(handle uintptr) (err error) {
	// purego panics when a symbol is missing; report that as an error instead.
	defer func() {
		if r := recover(); r != nil {
			err = fmt.Errorf("%s: reading the ABI hash from the native library: %v", libName, r)
		}
	}()

	var reported func() uint64
	purego.RegisterLibFunc(&reported, handle, abiSymbol)
	if got := reported(); got != abiHashValue {
		return fmt.Errorf(
			"%s: ABI mismatch: the native library reports %016x, these bindings expect %s; "+
				"regenerate the bindings with zbridge and rebuild the native library",
			libName, got, abiHash)
	}
	return nil
}

// bindAll resolves every exported symbol. bind is generated code that calls
// purego.RegisterLibFunc, which panics on a missing symbol -- possibly half way
// through the list -- so the panic is caught here, where the caller can still
// close the library.
func bindAll(handle uintptr) (err error) {
	defer func() {
		if r := recover(); r != nil {
			err = fmt.Errorf("%s: resolving native symbols: %v", libName, r)
		}
	}()

	bind(handle)
	return nil
}

// libraryPath returns a path the operating system can open. Unless the
// environment overrides it, the embedded copy is extracted into the user cache
// directory first.
func libraryPath() (string, error) {
	if p := os.Getenv(LibPathEnv); p != "" {
		return p, nil
	}
	if len(nativeLib) == 0 {
		return "", fmt.Errorf(
			"%s: no native library is embedded for %s/%s; set %s to the path of a locally built library",
			libName, runtime.GOOS, runtime.GOARCH, LibPathEnv)
	}

	sum := sha256.Sum256(nativeLib)
	tag := hex.EncodeToString(sum[:])[:16]

	cacheRoot, err := os.UserCacheDir()
	if err != nil {
		return "", fmt.Errorf("%s: locating the user cache directory: %w", libName, err)
	}
	dir := filepath.Join(cacheRoot, "zbridge", libName, libVersion+"-"+tag)
	path := filepath.Join(dir, nativeName)

	// The directory name is derived from the embedded bytes, never from what is
	// on disk, so it says nothing about the file sitting at that path. Hash the
	// file itself before handing it to the dynamic loader: on a shared or
	// group-writable cache directory (a container image, a CI box with a shared
	// HOME, a multi-user machine) anyone else who can write there could have
	// put a different library at that name, and dlopen would run its code in
	// this process. A mismatch re-extracts over it.
	if fileHasDigest(path, sum) {
		return path, nil
	}
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", fmt.Errorf("%s: creating %s: %w", libName, dir, err)
	}

	tmp, err := os.CreateTemp(dir, nativeName+".tmp-*")
	if err != nil {
		return "", fmt.Errorf("%s: creating a temporary file in %s: %w", libName, dir, err)
	}
	tmpName := tmp.Name()
	defer func() { _ = os.Remove(tmpName) }()

	if _, err := tmp.Write(nativeLib); err != nil {
		_ = tmp.Close()
		return "", fmt.Errorf("%s: writing %s: %w", libName, tmpName, err)
	}
	// The extracted file has to be executable for the loader to map it.
	if err := tmp.Chmod(0o755); err != nil {
		_ = tmp.Close()
		return "", fmt.Errorf("%s: making %s executable: %w", libName, tmpName, err)
	}
	if err := tmp.Close(); err != nil {
		return "", fmt.Errorf("%s: closing %s: %w", libName, tmpName, err)
	}
	// Rename is atomic within a directory, so concurrent processes cannot see a
	// half-written library.
	if err := os.Rename(tmpName, path); err != nil {
		// Windows refuses to replace a DLL another process already has loaded.
		// That is harmless as long as the file that is in the way is the very
		// library we were about to write, which only its digest can say.
		if fileHasDigest(path, sum) {
			return path, nil
		}
		return "", fmt.Errorf("%s: installing %s: %w", libName, path, err)
	}
	return path, nil
}

// fileHasDigest reports whether the file at path has exactly the given SHA-256
// digest. Every failure -- missing, unreadable, a directory, a short read --
// answers false, which makes the caller extract the embedded copy again.
func fileHasDigest(path string, want [sha256.Size]byte) bool {
	f, err := os.Open(path)
	if err != nil {
		return false
	}
	defer func() { _ = f.Close() }()

	h := sha256.New()
	if _, err := io.Copy(h, f); err != nil {
		return false
	}
	var got [sha256.Size]byte
	copy(got[:], h.Sum(nil))
	return got == want
}
