# Written once by zbridge and never regenerated: this file is yours.
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "zc"
version = "0.1.0"
description = "Python bindings for the zc native library."
requires-python = ">=3.9"

[tool.hatch.build.targets.wheel]
packages = ["zc"]

[tool.hatch.build]
# The native libraries under zc/_native/<target>/ are build outputs, so
# they are usually gitignored; hatchling skips gitignored files unless
# they are listed here.
artifacts = [
  "zc/py.typed",
  "zc/_native/**/*.so",
  "zc/_native/**/*.dylib",
  "zc/_native/**/*.dll",
]
